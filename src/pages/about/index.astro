---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const aboutEntry = await getEntry("pages", "about");
if (!aboutEntry) throw new Error("About content not found.");
const { Content } = await render(aboutEntry);
---

<BaseLayout title={aboutEntry.data.title} description={aboutEntry.data.description}>
    <header class="page-header">
        <h1 class="page-title">{aboutEntry.data.title}</h1>
        {aboutEntry.data.subtitle && <p class="page-subtitle">{aboutEntry.data.subtitle}</p>}
    </header>
    <div class="container-narrow prose">
        <Content />
    </div>
</BaseLayout>
